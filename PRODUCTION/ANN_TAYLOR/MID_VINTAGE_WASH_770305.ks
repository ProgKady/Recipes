  <SCRIPT>
            
            DOCUMENT.ADDEVENTLISTENER('KEYDOWN', EVENT => {
  CONSOLE.LOG(`USER PRESSED: ${EVENT.KEY}`);
  EVENT.PREVENTDEFAULT();
  RETURN FALSE;
});
            
            </SCRIPT> 
  <SCRIPT>
