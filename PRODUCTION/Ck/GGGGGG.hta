<HTA:APPLICATION id="Kadinio"
applicationName="Kadysoft"
border="thin"
borderStyle="normal"
caption="yes"
icon="C:\Kadysoft.ico"
maximizeButton="yes"
minimizeButton="yes"
showInTaskbar="yes"
windowState="normal"
innerBorder="yes"
navigable="yes"
scroll="yes"
scrollFlat="yes"
singleInstance="yes"
sysMenu="yes"
contextMenu=no
selection=no
version="1.0" /><style>
        body {
            user-select: none;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
        }
    </style><script>
        document.addEventListener('dragstart', function(event) {
            event.preventDefault();
        });

        document.addEventListener('drop', function(event) {
            event.preventDefault();
        });

        document.addEventListener('contextmenu', function(event) {
            event.preventDefault();
        });
    </script><script>
  
  window.addEventListener(`contextmenu`, (e) => {
    e.preventDefault();
});
  
  </script>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0"/>
		<meta http-equiv="X-UA-Compatible" content="ie=edge" /><script>
            
            document.addEventListener('keydown', event => {
  console.log(`User pressed: ${event.key}`);
  event.preventDefault();
  return false;
});
            
            </script><script>
        document.addEventListener('keydown', function (event) {
            // Disable specific keys or key combinations
            event.preventDefault();
        });
    </script>





<!DOCTYPE HTML>
<HTML LANG="AR">
<HEAD>
<TITLE>KADYSOFT</TITLE>
<META CHARSET="UTF-8">
<META NAME="VIEWPORT" CONTENT="WIDTH=DEVICE-WIDTH, INITIAL-SCALE=1.0">
<STYLE>TD {
HEIGHT:5PX;
MAX-WIDTH:100%;
WHITE-SPACE:NOWRAP;
}
TABLE {
HEIGHT:5PX;
MAX-WIDTH:100%;
HEIGHT:100%;
WHITE-SPACE:NOWRAP;
}
TR {
HEIGHT:5PX;
MAX-WIDTH:100%;
WHITE-SPACE:NOWRAP;
}/* CENTERED WATERMARK */
    .WATERMARK {
      POSITION: FIXED;
      TOP: 50%;
      LEFT: 50%;
      TRANSFORM: TRANSLATE(-50%, -50%) ROTATE(-45DEG);
      BACKGROUND-IMAGE: URL('LOGO.PNG'); /* REPLACE WITH THE PATH TO T & C GARMENTS LOGO */
      BACKGROUND-REPEAT: NO-REPEAT;
      BACKGROUND-SIZE: CONTAIN;
      WIDTH: 300PX;
      HEIGHT: 200PX;
      OPACITY: 0.3;
      POINTER-EVENTS: NONE;
      Z-INDEX: 1000;
    }
    /* REPEATED WATERMARK */
    .WATERMARK-REPEATED {
      POSITION: FIXED;
      TOP: 0;
      LEFT: 0;
      WIDTH: 100%;
      HEIGHT: 100%;
      BACKGROUND-IMAGE: URL('LOGO.PNG'); /* REPLACE WITH THE PATH TO T & C GARMENTS LOGO */
      BACKGROUND-REPEAT: REPEAT;
      BACKGROUND-SIZE: 300PX 200PX;
      OPACITY: 0.2;
      POINTER-EVENTS: NONE;
      Z-INDEX: 1000;
    }</STYLE></HEAD>
<BODY><CENTER>
<DIV CLASS="WATERMARK"></DIV>

<!-- CREATING RECIPE FROM KADYSOFT LTD.-->


<STYLE>
        BODY {
            USER-SELECT: NONE;
            -WEBKIT-USER-SELECT: NONE;
            -MOZ-USER-SELECT: NONE;
            -MS-USER-SELECT: NONE;
        }
    </STYLE><SCRIPT>
        DOCUMENT.ADDEVENTLISTENER('DRAGSTART', FUNCTION(EVENT) {
            EVENT.PREVENTDEFAULT();
        });

        DOCUMENT.ADDEVENTLISTENER('DROP', FUNCTION(EVENT) {
            EVENT.PREVENTDEFAULT();
        });

        DOCUMENT.ADDEVENTLISTENER('CONTEXTMENU', FUNCTION(EVENT) {
            EVENT.PREVENTDEFAULT();
        });
    </SCRIPT><SCRIPT>
  
  WINDOW.ADDEVENTLISTENER(`CONTEXTMENU`, (E) => {
    E.PREVENTDEFAULT();
});
  
  </SCRIPT>
<META CHARSET="UTF-8"/>
<META NAME="VIEWPORT" CONTENT="WIDTH=DEVICE-WIDTH, USER-SCALABLE=NO, INITIAL-SCALE=1.0, MAXIMUM-SCALE=1.0, MINIMUM-SCALE=1.0"/>
		<META HTTP-EQUIV="X-UA-COMPATIBLE" CONTENT="IE=EDGE" /><SCRIPT>
            
            DOCUMENT.ADDEVENTLISTENER('KEYDOWN', EVENT => {
  CONSOLE.LOG(`USER PRESSED: ${EVENT.KEY}`);
  EVENT.PREVENTDEFAULT();
  RETURN FALSE;
});
            
            </SCRIPT><SCRIPT>
        DOCUMENT.ADDEVENTLISTENER('KEYDOWN', FUNCTION (EVENT) {
            // DISABLE SPECIFIC KEYS OR KEY COMBINATIONS
            EVENT.PREVENTDEFAULT();
        });
